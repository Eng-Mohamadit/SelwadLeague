            </button>
            <button type="button" class="card team-card" data-team="F">
                <div class="crest">F</div>
                <h3>عيون الحرامية</h3>
                <span class="team-code">3 نقاط</span>
            </button>
            <button type="button" class="card team-card" data-team="H">
                <div class="crest">H</div>
                <h3>الحواكير</h3>
                <span class="team-code">3 نقاط</span>
            </button>
            <button type="button" class="card team-card" data-team="G">
                <div class="crest">G</div>
