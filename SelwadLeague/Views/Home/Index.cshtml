                <span class="team-code">9 نقاط</span>
            </button>
            <button type="button" class="card team-card" data-team="C">
                <div class="crest">C</div>
                <h3>راس بركة</h3>
                <span class="team-code">9 نقاط</span>
            </button>
            <button type="button" class="card team-card" data-team="E">
                <div class="crest">E</div>
                <h3>راس علي</h3>
                <span class="team-code">6 نقاط</span>
            </button>
            <button type="button" class="card team-card" data-team="B">
                <div class="crest">B</div>
