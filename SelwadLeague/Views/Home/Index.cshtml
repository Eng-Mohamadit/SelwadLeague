<style>

    /* Predictions List */
    #predictionsList {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 14px;
        margin-top: 20px;
    }

    .prediction-item {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 18px;
        border: 1px solid rgba(128, 128, 128, 0.2);
        border-radius: 14px;
        background: var(--card-bg, rgba(128, 128, 128, 0.04));
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .prediction-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
        }

    .prediction-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .prediction-user {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
    }

    .prediction-avatar {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.12);
        font-size: 18px;
    }

    .prediction-user-name {
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .prediction-round {
        font-size: 12px;
        opacity: 0.7;
        margin-top: 3px;
    }

    .prediction-match {
        text-align: center;
        font-weight: 700;
        line-height: 1.7;
        padding: 12px 8px;
        border-radius: 10px;
        background: rgba(128, 128, 128, 0.07);
    }

    .prediction-score {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 18px;
    }

    .prediction-score-number {
        min-width: 48px;
        padding: 8px 14px;
        border-radius: 10px;
        background: rgba(37, 99, 235, 0.1);
        text-align: center;
        font-size: 24px;
        font-weight: 900;
    }

    .prediction-score-separator {
        font-weight: 800;
        opacity: 0.6;
    }

    .prediction-delete {
        width: 100%;
        padding: 9px 12px;
        border: 1px solid rgba(220, 38, 38, 0.25);
        border-radius: 9px;
        background: rgba(220, 38, 38, 0.07);
        color: #dc2626;
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .prediction-delete:hover {
            background: rgba(220, 38, 38, 0.15);
        }

    .predictions-empty {
        grid-column: 1 / -1;
        padding: 30px 15px;
        text-align: center;
        border: 1px dashed rgba(128, 128, 128, 0.35);
        border-radius: 12px;
        opacity: 0.75;
    }

    @@media (max-width: 500px) {
        #predictionsList

    {
        grid-template-columns: 1fr;
    }

    .prediction-item {
        padding: 15px;
    }

    }


    .prediction-card {
        padding: 24px;
    }

    .pred-field {
        margin-bottom: 20px;
    }

        .pred-field label,
        .pred-score-form label {
            display: block;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .pred-field input,
        .pred-field select,
        .pred-score-form input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font: inherit;
            box-sizing: border-box;
        }

    .pred-score-form {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: end;
        gap: 15px;
        margin-bottom: 20px;
        text-align: center;
    }

        .pred-score-form strong {
            padding-bottom: 12px;
        }

    .prediction-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 15px 0;
        border-bottom: 1px solid rgba(128, 128, 128, 0.25);
    }

        .prediction-item:last-child {
            border-bottom: none;
        }

        .prediction-item p {
            margin: 5px 0;
        }

    .prediction-result {
        font-size: 18px;
        font-weight: 800;
        white-space: nowrap;
    }

    .prediction-item .submit-btn {
        flex-shrink: 0;
    }

    @@media (max-width: 500px) {
        .prediction-card

    {
        padding: 16px;
    }

    .pred-score-form {
        gap: 8px;
    }

    .prediction-item {
        flex-wrap: wrap;
    }

    }
</style>

