    (function () {
        var dlg = document.getElementById('teamDialog');
        var list = document.getElementById('tdPlayers');

        document.querySelectorAll('.team-card[data-team]').forEach(function (card) {
            card.addEventListener('click', function () {
                var code = card.dataset.team;
                var players = PLAYERS[code] || [];
                document.getElementById('tdCrest').textContent = code;
                document.getElementById('tdName').textContent = card.querySelector('h3').textContent;
                document.getElementById('tdCount').textContent = players.length ? players.length + ' لاعب' : '';
                list.innerHTML = players.length
                    ? players.map(function (p) { return '<li>' + p + '</li>'; }).join('')
                    : '<li class="td-empty">لم تُضف قائمة اللاعبين بعد</li>';
                dlg.showModal();
            });
        });

        function closeDlg() {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { dlg.close(); return; }
            dlg.classList.add('closing');
            dlg.addEventListener('animationend', function done(e) {
                if (e.target !== dlg) return;
                dlg.removeEventListener('animationend', done);
                dlg.classList.remove('closing');
                dlg.close();
            });
        }
        document.getElementById('tdClose').onclick = closeDlg;
        dlg.addEventListener('click', function (e) { if (e.target === dlg) closeDlg(); });
        dlg.addEventListener('cancel', function (e) { e.preventDefault(); closeDlg(); });
    })();

    // الهدافون: تم وضع أكرم عبد الغني في النهاية، وتعديل الترتيب ليظهر مسلسلاً (1, 2, 3, 4)
    var SCORERS = [
        ["عمر أحمد", "A", 3],
        ["أيهم عبدالغني", "A", 3],
        ["وائل خالد", "A", 2],
        ["وليد منير", "D", 2],
        ["أكرم عبد الغني", "B", 2]
    ];

    (function () {
        var names = (typeof TEAMS !== 'undefined') ? TEAMS : {
            A: "تل العاصور", B: "الفدائي", C: "راس بركة", D: "وادي النمر",
            E: "راس علي", F: "عيون الحرامية", G: "دوار الشهيد", H: "الحواكير"
        };
        var list = document.getElementById('scorerList');

        // استخدام المصفوفة كما هي بدون فرز تلقائي لضمان بقاء أكرم في النهاية، أو يمكنك ترتيبها حسب رغبتك
        var data = SCORERS;

        if (!data.length) {
            list.innerHTML = '<li class="sc-empty">لم تُسجّل أهداف بعد</li>';
            return;
        }

        list.innerHTML = data.map(function (p, i) {
            var rank = i + 1; // ترقيم مسلسل 1, 2, 3, 4
            return '<li class="sc-row">' +
                '<span class="sc-rank">' + rank + '</span>' +
                '<strong>' + p[0] + '</strong>' +
                '<span class="sc-team">' + (names[p[1]] || p[1]) + '</span>' +
                '<b class="sc-goals">' + p[2] + '</b></li>';
        }).join('');
    })();
</script>

<script>

    (function () {
        const select = document.getElementById("matchSelect");
        const form = document.getElementById("predictionForm");
        const list = document.getElementById("predictionsList");

        const nameInput = document.getElementById("predictorName");
        const homeScoreInput = document.getElementById("homeScore");
        const awayScoreInput = document.getElementById("awayScore");

        const homeTeamLabel = document.getElementById("homeTeamLabel");
        const awayTeamLabel = document.getElementById("awayTeamLabel");

        const STORAGE_KEY = "selwadPredictions";
        // حذف جميع التوقعات المحفوظة
        //localStorage.removeItem(STORAGE_KEY);

        // تعبئة قائمة المباريات من جميع الجولات
         // عرض مباريات الجولة الثانية فقط
        const roundIndex = 1; 
        if (ROUNDS[roundIndex]) {
            ROUNDS[roundIndex].forEach((match, matchIndex) => {
                const option = document.createElement("option");

                option.value = `${roundIndex}-${matchIndex}`;
                option.textContent =
                    `الجولة 2: ${TEAMS[match[0]]} × ${TEAMS[match[1]]}`;

                select.appendChild(option);
            });
        }


        // قراءة التوقعات المحفوظة
        function loadPredictions() {
            try {
                const saved = JSON.parse(
                    localStorage.getItem(STORAGE_KEY) || "[]"
                );

                return Array.isArray(saved) ? saved : [];
            } catch {
                return [];
            }
        }

        let predictions = loadPredictions();

        // حفظ التوقعات
        function savePredictions() {
            try {
                localStorage.setItem(
                    STORAGE_KEY,
                    JSON.stringify(predictions)
                );

                return true;
            } catch {
                alert("تعذّر حفظ التوقعات في المتصفح.");
                return false;
            }
        }

        // عرض قائمة التوقعات
        function renderPredictions() {
            list.replaceChildren();

            if (predictions.length === 0) {
                const emptyMessage = document.createElement("div");
                emptyMessage.className = "predictions-empty";
                emptyMessage.textContent = "⚽ لا توجد توقعات حتى الآن، كن أول من يتوقع!";
                list.appendChild(emptyMessage);
                return;
            }

            // عرض أحدث التوقعات أولاً
            predictions.forEach((prediction, index) => {
                const item = document.createElement("div");
                item.className = "prediction-item";

                // القسم العلوي: اسم الشخص والجولة
                const top = document.createElement("div");
                top.className = "prediction-top";

                const user = document.createElement("div");
                user.className = "prediction-user";

                const avatar = document.createElement("div");
                avatar.className = "prediction-avatar";
                avatar.textContent = "👤";

                const userDetails = document.createElement("div");

                const userName = document.createElement("div");
                userName.className = "prediction-user-name";
                userName.textContent = prediction.name || "غير معروف";

                const round = document.createElement("div");
                round.className = "prediction-round";
                round.textContent = `الجولة ${prediction.round}`;

                userDetails.append(userName, round);
                user.append(avatar, userDetails);
                top.appendChild(user);

                // اسم المباراة
                const match = document.createElement("div");
                match.className = "prediction-match";
                match.textContent = prediction.match;

                // النتيجة المتوقعة
                const score = document.createElement("div");
                score.className = "prediction-score";

                const homeScore = document.createElement("span");
                homeScore.className = "prediction-score-number";
                homeScore.textContent = prediction.homeScore;

                const separator = document.createElement("span");
                separator.className = "prediction-score-separator";
                separator.textContent = ":";

                const awayScore = document.createElement("span");
                awayScore.className = "prediction-score-number";
                awayScore.textContent = prediction.awayScore;

                score.append(homeScore, separator, awayScore);

                // زر الحذف: UI فقط بدون وظيفة
                const remove = document.createElement("button");
                remove.type = "button";
                remove.className = "prediction-delete";
                //remove.textContent = "🗑️ حذف التوقع";

                // تجميع عناصر التوقع
                item.append(top, match, score, remove);
                list.appendChild(item);
            });
        }


        // تحديث أسماء الفرق عند اختيار المباراة
        select.addEventListener("change", function () {
            if (!select.value) {
                homeTeamLabel.textContent = "الفريق الأول";
                awayTeamLabel.textContent = "الفريق الثاني";
                return;
            }

            const [roundIndex, matchIndex] =
                select.value.split("-").map(Number);

            const match = ROUNDS[roundIndex]?.[matchIndex];

            homeTeamLabel.textContent =
                match ? TEAMS[match[0]] : "الفريق الأول";

            awayTeamLabel.textContent =
                match ? TEAMS[match[1]] : "الفريق الثاني";
        });

        // إضافة توقع جديد
        form.addEventListener("submit", function (event) {
        event.preventDefault();

        const predictorName = nameInput.value.trim();
        const selectedMatch = select.value;

        const homeRaw = homeScoreInput.value;
        const awayRaw = awayScoreInput.value;

        const homeScore = Number(homeRaw);
        const awayScore = Number(awayRaw);

        // التحقق من الاسم
        if (!predictorName) {
            Swal.fire({
                icon: "warning",
                title: "الاسم مطلوب",
                text: "يرجى إدخال اسمك قبل إرسال التوقع.",
                confirmButtonText: "حسناً",
                confirmButtonColor: "#d97706"
            });

            nameInput.focus();
            return;
        }

        // التحقق من اختيار المباراة
        if (!selectedMatch) {
            Swal.fire({
                icon: "warning",
                title: "اختر المباراة",
                text: "يرجى اختيار المباراة التي تريد توقع نتيجتها.",
                confirmButtonText: "حسناً",
                confirmButtonColor: "#d97706"
            });

            select.focus();
            return;
        }

        const [roundIndex, matchIndex] =
            selectedMatch.split("-").map(Number);

        const match = ROUNDS[roundIndex]?.[matchIndex];

        // التحقق من صحة النتيجة
        if (
            !match ||
            homeRaw === "" ||
            awayRaw === "" ||
            !Number.isInteger(homeScore) ||
            !Number.isInteger(awayScore) ||
            homeScore < 0 ||
            awayScore < 0 ||
            homeScore > 99 ||
            awayScore > 99
        ) {
            Swal.fire({
                icon: "warning",
                title: "نتيجة غير صحيحة",
                text: "يرجى إدخال نتيجة صحيحة من 0 إلى 99.",
                confirmButtonText: "حسناً",
                confirmButtonColor: "#d97706"
            });

            return;
        }

        // اسم المباراة
        const matchName =
            `${TEAMS[match[0]]} × ${TEAMS[match[1]]}`;

        // منع تكرار توقع الشخص لنفس المباراة
        const alreadyPredicted = predictions.some(prediction =>
            (prediction.name || "").trim().toLowerCase() ===
                predictorName.toLowerCase() &&
            prediction.match === matchName
        );

        if (alreadyPredicted) {
            Swal.fire({
                icon: "warning",
                title: "لقد سجلت توقعك مسبقاً",
                text: "لا يمكنك توقع نفس المباراة أكثر من مرة.",
                confirmButtonText: "حسناً",
                confirmButtonColor: "#d97706"
            });

            return;
        }

        // إنشاء التوقع الجديد
        const newPrediction = {
            name: predictorName,
            match: matchName,
            round: roundIndex + 1,
            homeScore: homeScore,
            awayScore: awayScore
        };

        predictions.push(newPrediction);

        // حفظ التوقع
        if (!savePredictions()) {
            predictions.pop();
            return;
        }


        // تحديث قائمة التوقعات
        renderPredictions();

        // رسالة نجاح
        Swal.fire({
            icon: "success",
            title: "تم إرسال توقعك بنجاح",
            text: "بالتوفيق في توقعاتك! ⚽",
            confirmButtonText: "تمام",
            confirmButtonColor: "#16a34a",
            timer: 2500,
            timerProgressBar: true,
            customClass: {
                popup: "prediction-success-popup"
            }
        });

        // مسح النتيجة بعد الإرسال
        homeScoreInput.value = "";
        awayScoreInput.value = "";
    });


        // عرض التوقعات عند فتح الصفحة
        renderPredictions();
    })();

</script>

<script id="newpredictions">


    (function () {
        const form = document.getElementById("predictionForm");
        if (!form) return;

        const select = document.getElementById("matchSelect");
        const nameInput = document.getElementById("predictorName");
        const homeScore = document.getElementById("homeScore");
        const awayScore = document.getElementById("awayScore");
        const list = document.getElementById("predictionsList");
        const filter = document.getElementById("predictionRoundFilter");

        const roundLabel = document.getElementById("predictionRoundLabel");
        const homeLabel = document.getElementById("homeTeamLabel");
        const awayLabel = document.getElementById("awayTeamLabel");
        const homeCrest = document.getElementById("homeCrest");
        const awayCrest = document.getElementById("awayCrest");

        const roundIndex = 1; // الجولة الثانية فقط

        // بيانات تجريبية للواجهة، وليست بيانات حقيقية.
        let demoPredictions = [
            { name: "محمد أحمد", round: 2, matchIndex: 0, home: 2, away: 1 },
            { name: "أحمد خالد", round: 2, matchIndex: 1, home: 1, away: 1 },
            { name: "عمر سمير", round: 2, matchIndex: 2, home: 3, away: 0 }
        ];

        const matches = ROUNDS[roundIndex] || [];

        matches.forEach(function (match, index) {
            const option = document.createElement("option");
            option.value = roundIndex + "-" + index;
            option.textContent = "الجولة 2: " +
                TEAMS[match[0]] + " × " + TEAMS[match[1]];
            select.appendChild(option);
        });

        function el(tag, className, text) {
            const node = document.createElement(tag);
            if (className) node.className = className;
            if (text !== undefined) node.textContent = text;
            return node;
        }

        function getMatch(prediction) {
            return ROUNDS[prediction.round - 1]?.[prediction.matchIndex];
        }

        function updatePreview() {
            const parts = select.value.split("-").map(Number);
            const match = select.value ? ROUNDS[parts[0]]?.[parts[1]] : null;

            if (!match) {
                homeLabel.textContent = "الفريق الأول";
                awayLabel.textContent = "الفريق الثاني";
                homeCrest.textContent = "?";
                awayCrest.textContent = "?";
                roundLabel.textContent = "اختر مباراة للبدء";
                return;
            }

            homeLabel.textContent = TEAMS[match[0]];
            awayLabel.textContent = TEAMS[match[1]];
            homeCrest.textContent = match[0];
            awayCrest.textContent = match[1];
            roundLabel.textContent = "الجولة " + (parts[0] + 1);
        }

        function renderFixtures() {
            const fixtures = document.getElementById("predictionFixtures");
            if (!fixtures) return;

            fixtures.replaceChildren();

            matches.forEach(function (match, index) {
                const card = el("div", "pred-fixture");
                card.tabIndex = 0;
                card.setAttribute("role", "button");
                card.setAttribute("aria-label",
                    "توقع مباراة " + TEAMS[match[0]] + " ضد " + TEAMS[match[1]]);

                const top = el("div", "pred-fixture-top");
                top.append(
                    el("span", "", "الجولة الثانية"),
                    el("span", "", "● متاحة")
                );

                const teams = el("div", "pred-fixture-teams");

                function createTeam(code) {
                    const team = el("div", "pred-fixture-team");
                    team.append(
                        el("div", "pred-fixture-crest", code),
                        el("strong", "", TEAMS[code])
                    );
                    return team;
                }

                teams.append(
                    createTeam(match[0]),
                    el("span", "pred-fixture-vs", "VS"),
                    createTeam(match[1])
                );

                card.append(
                    top,
                    teams,
                    el("div", "pred-fixture-bottom", "توقّع هذه المباراة ←")
                );

                function chooseMatch() {
                    select.value = roundIndex + "-" + index;
                    updatePreview();
                    document.getElementById("predictionForm").scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });
                }

                card.addEventListener("click", chooseMatch);
                card.addEventListener("keydown", function (event) {
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        chooseMatch();
                    }
                });

                fixtures.appendChild(card);
            });
        }

        function renderPredictions() {
            list.replaceChildren();

            const filtered = demoPredictions.filter(function (p) {
                return filter.value === "all" ||
                    String(p.round) === filter.value;
            });

            if (!filtered.length) {
                list.appendChild(el(
                    "div",
                    "pred-empty",
                    "⚽ لا توجد توقعات لهذه الجولة حتى الآن."
                ));
                return;
            }

            filtered.slice().reverse().forEach(function (p) {
                const match = getMatch(p);
                if (!match) return;

                const row = el("div", "pred-history-item");

                const user = el("div", "pred-history-user");
                const avatar = el("div", "pred-history-avatar",
                    p.name.trim().charAt(0) || "؟");
                const details = document.createElement("div");

                details.append(
                    el("strong", "", p.name),
                    el("span", "", "الجولة " + p.round)
                );
                user.append(avatar, details);

                const teams = el("div", "pred-history-match");
                teams.append(
                    el("span", "", TEAMS[match[0]]),
                    el("b", "", "VS"),
                    el("span", "", TEAMS[match[1]])
                );

                const score = el("div", "pred-history-score");
                score.append(
                    el("span", "", "النتيجة المتوقعة"),
                    el("strong", "", p.home + " : " + p.away)
                );

                row.append(
                    user,
                    teams,
                    score,
                    el("span", "pred-history-status", "بانتظار المباراة")
                );

                list.appendChild(row);
            });
        }

        select.addEventListener("change", updatePreview);
        filter.addEventListener("change", renderPredictions);

        form.addEventListener("submit", function (event) {
            event.preventDefault();

            const name = nameInput.value.trim();
            const homeRaw = homeScore.value;
            const awayRaw = awayScore.value;
            const h = Number(homeRaw);
            const a = Number(awayRaw);

            if (!name || !select.value) {
                alert("أدخل اسمك واختر المباراة أولاً.");
                return;
            }

            if (
                homeRaw === "" || awayRaw === "" ||
                !Number.isInteger(h) || !Number.isInteger(a) ||
                h < 0 || a < 0 || h > 99 || a > 99
            ) {
                alert("أدخل نتيجة صحيحة من 0 إلى 99.");
                return;
            }

            const parts = select.value.split("-").map(Number);
            const match = ROUNDS[parts[0]]?.[parts[1]];
            if (!match) return;

            const duplicate = demoPredictions.some(function (p) {
                const oldMatch = getMatch(p);
                return p.name.trim().toLowerCase() === name.toLowerCase() &&
                    p.round === parts[0] + 1 &&
                    oldMatch &&
                    oldMatch[0] === match[0] &&
                    oldMatch[1] === match[1];
            });

            if (duplicate) {
                alert("هذا الاسم لديه توقع تجريبي مسجل لهذه المباراة.");
                return;
            }

            demoPredictions.push({
                name: name,
                round: parts[0] + 1,
                matchIndex: parts[1],
                home: h,
                away: a
            });

            renderPredictions();

            const counter = document.getElementById("totalPredictions");
            counter.textContent = Number(counter.textContent || 0) + 1;

            nameInput.value = "";
            homeScore.value = "";
            awayScore.value = "";

            if (typeof Swal !== "undefined") {
                Swal.fire({
                    icon: "success",
                    title: "تم تسجيل التوقع",
                    text: "تمت إضافته للواجهة التجريبية فقط، دون حفظ على الخادم.",
                    confirmButtonText: "تمام",
                    confirmButtonColor: "#16a34a"
                });
            } else {
                alert("تمت إضافة التوقع للواجهة التجريبية فقط.");
            }
        });

        renderFixtures();
        renderPredictions();
        updatePreview();
    })();

</script>
