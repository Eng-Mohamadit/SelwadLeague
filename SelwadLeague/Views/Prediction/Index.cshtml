<script>
    document.querySelectorAll('.team-rank-item').forEach(item => {
        item.addEventListener('click', function (e) {
            const select = this.querySelector('.team-rank-select');

            if (select && e.target !== select) {
                select.focus();

                // فتح القائمة عند الضغط على أي مكان في السجل
                select.click();
            }
        });
    });
</script>