@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مسابقة توقعات دوري سلواد</title>
    <!-- استدعاء الخط والأيقونات -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .team-rank-select {
            background: transparent;
            border: none;
            outline: none;
            color: inherit;
            font: inherit;
            cursor: pointer;
            padding: 0;
            appearance: none;
            -webkit-appearance: none;
            direction: rtl;
        }

            .team-rank-select option {
                background: #1b1b1b;
                color: #fff;
            }
        :root {
            --bg-main: #0b1329;
            --bg-card: #141e33;
            --bg-card-hover: #1b2642;
            --border-color: #233250;
            --accent-gold: #f59e0b;
            --text-main: #ffffff;
            --text-muted: #94a3b8;
            --emerald-color: #10b981;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
        }

        /* شريط التنقل العلوي */
        .navbar {
            background-color: rgba(15, 23, 42, 0.95);
            border-bottom: 1px solid var(--border-color);
            padding: 0.8rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            background: var(--accent-gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0f172a;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 25px;
            list-style: none;
        }

            .nav-links a {
                color: var(--text-muted);
                text-decoration: none;
                font-size: 14px;
                transition: 0.3s;
            }

                .nav-links a.active, .nav-links a:hover {
                    color: var(--accent-gold);
                    border-bottom: 2px solid var(--accent-gold);
                    padding-bottom: 4px;
                }

        /* القسم الرئيسي (الهيرو) */
        .hero {
            background: linear-gradient(to bottom, #064e3b, var(--bg-main));
            padding: 2.5rem 1rem;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
        }

            .hero h1 {
                font-size: 2rem;
                font-weight: 900;
                margin-bottom: 8px;
            }

            .hero p {
                color: var(--text-muted);
                font-size: 0.9rem;
            }

        /* بطاقات الإحصائيات العلوية */
        .stats-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 1rem 1.5rem;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-width: 260px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        .stat-info span {
            display: block;
            font-size: 12px;
            color: var(--text-muted);
            text-align: right;
            margin-bottom: 4px;
        }

        .stat-value {
            font-size: 1.6rem;
            font-weight: 900;
            color: var(--accent-gold);
            text-align: right;
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

            .stat-icon.cyan {
                background: rgba(6, 182, 212, 0.1);
                color: #06b6d4;
            }

            .stat-icon.gold {
                background: rgba(245, 158, 11, 0.1);
                color: var(--accent-gold);
            }

        /* حاوية المحتوى الرئيسي */
        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        /* بطاقة نموذج التوقعات الكبرى */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.2rem;
            font-weight: 700;
        }

        .badge-step {
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            color: var(--text-muted);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            padding: 0.75rem 1rem;
            border-radius: 12px;
            color: #fff;
            font-size: 0.9rem;
            outline: none;
        }

            .form-control:focus {
                border-color: var(--accent-gold);
            }

        /* الأقسام الداخلية للنموذج (يمين ويسار) */
        .predictions-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        .sub-box {
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid var(--border-color);
            padding: 1.2rem;
            border-radius: 14px;
            margin-bottom: 1.2rem;
        }

            .sub-box h3 {
                font-size: 0.95rem;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .sub-box p {
                font-size: 11px;
                color: var(--text-muted);
                margin-bottom: 1rem;
            }

        /* عناصر ترتيب الفرق */
        .team-rank-item {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 0.6rem 1rem;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .rank-number {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--border-color);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
        }

            .rank-number.first {
                background: var(--accent-gold);
                color: #000;
            }

        /* عناصر مباريات التوقعات */
        .match-row {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 0.7rem 1rem;
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            font-size: 0.85rem;
        }

        .team-side {
            display: flex;
            align-items: center;
            gap: 8px;
            width: 35%;
        }

            .team-side.left {
                justify-content: flex-end;
                text-align: left;
            }

        .score-input {
            width: 40px;
            text-align: center;
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            padding: 5px;
            border-radius: 6px;
            color: #fff;
            font-size: 0.85rem;
        }

        .btn-submit {
            background: var(--accent-gold);
            color: #0f172a;
            font-weight: bold;
            border: none;
            padding: 0.8rem 2.5rem;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin: 2rem auto 0 auto;
            font-size: 0.95rem;
            transition: 0.3s;
        }

            .btn-submit:hover {
                background: #d97706;
            }

        /* الويدجات الثلاثة السفلى */
        .bottom-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .widget-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .widget-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 1rem;
            padding-bottom: 0.6rem;
            border-bottom: 1px solid var(--border-color);
        }

        /* تفاصيل المتصدر */
        .top-scorer-box {
            text-align: center;
        }

        .avatar-circle {
            width: 80px;
            height: 80px;
            margin: 0.5rem auto;
            border-radius: 50%;
            border: 3px solid var(--accent-gold);
            background: var(--bg-main);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            font-size: 1.8rem;
            color: var(--text-muted);
        }

        .crown-badge {
            position: absolute;
            top: -10px;
            background: var(--accent-gold);
            color: #000;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
        }

        /* جدول لوحة المتصدرين المصغر */
        .leaderboard-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(15, 23, 42, 0.6);
            padding: 0.6rem 0.8rem;
            border-radius: 10px;
            border: 1px solid rgba(35, 50, 80, 0.5);
            margin-bottom: 8px;
            font-size: 0.85rem;
        }

        .footer-link {
            text-align: center;
            margin-top: 1rem;
        }

            .footer-link a {
                color: var(--accent-gold);
                font-size: 0.75rem;
                text-decoration: none;
            }

        @@media (max-width: 900px) {
            .form-grid, .predictions-grid, .bottom-grid

        {
            grid-template-columns: 1fr;
        }

        }
    </style>
</head>

