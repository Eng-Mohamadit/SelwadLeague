<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>SELWAD LEAGUE | دوري سلواد لكرة القدم</title>
    <meta name="description" content="الموقع الرسمي لدوري سلواد لكرة القدم">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SelwadLeague.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <div class="wrap nav">
            <a class="brand" href="/">
                <span class="brand-mark">⚽</span>
                <span>
                    <strong>SELWAD LEAGUE</strong>
                    <small>دوري سلواد لكرة القدم</small>
                </span>
            </a>
            <nav class="menu">
                <a href="#matches">المباريات</a>
                <a href="#table">الترتيب</a>
                <a href="#teams">الفرق</a>
                <a href="#scorers">الهدافون</a>
                <a href="#predictions">التوقعات</a>
            </nav>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
    <div class="wrap foot-grid">
        <div>
            <strong class="foot-brand">⚽ SELWAD LEAGUE</strong>
            <p>الموقع الرسمي لدوري سلواد لكرة القدم: مباريات ونتائج وأخبار الدوري بمكان واحد.</p>
        </div>
        <div>
            <h4>روابط سريعة</h4>
            <a href="#matches">المباريات</a>
            <a href="#table">الترتيب</a>
            <a href="#teams">الفرق</a>
            <a href="#news">الأخبار</a>
        </div>
        <div>
            <h4>تابعنا</h4>
            <a href="#">فيسبوك</a>
            <a href="https://www.instagram.com/selwad_league?stkn=MW5rdTYxMnp0N2JtdA%3D%3D" target="_blank" rel="noopener noreferrer">إنستغرام</a>            
            <a href="#">واتساب</a>
        </div>
    </div>
    <div class="foot-copy">SELWAD LEAGUE © 2026 — جميع الحقوق محفوظة</div>
</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
